{
  "name": "@narada-core/nars-client-projection-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "nars_client_projection_contract",
    "owns": [
      "client_projection_capability_sets",
      "client_attach_command_registry",
      "client_projection_verbosity_policy",
      "operator_view_policy",
      "projection_command_method_aliases",
      "web_operator_command_projection"
    ],
    "does_not_own": [
      "carrier_protocol_schema_validation",
      "runtime_session_execution",
      "browser_ui_rendering"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/nars-client-projection-contract.d.ts",
      "import": "./dist/nars-client-projection-contract.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/nars-client-projection-contract.d.ts",
  "dependencies": {
    "@narada-core/agent-identity": "workspace:*",
    "@narada-core/nars-runtime-contract": "workspace:*",
    "@narada-core/nars-session-core": "workspace:*"
  },
  "scripts": {
    "test": "bun test src",
    "test:node": "node --import tsx --test src/*.test.ts",
    "pretest": "pnpm run build",
    "pretest:node": "pnpm run build:node",
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "description": "NARS client projection capability contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/nars-client-projection-contract"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "files": [
    "dist/"
  ]
}
