{
  "name": "@narada-core/agent-start-renderer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/agent-start-renderer.d.ts",
      "import": "./dist/agent-start-renderer.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@narada-core/agent-identity": "workspace:*"
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "test": "bun test src/agent-start-renderer.test.ts",
    "test:node": "node --import tsx --test src/agent-start-renderer.test.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "description": "Shared renderer for Narada agent-start pre-carrier launch output",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/agent-start-renderer"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
