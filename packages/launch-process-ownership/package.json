{
  "name": "@narada2/launch-process-ownership",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "launch_process_ownership_contract",
    "owns": [
      "launch_process_ownership_schema",
      "launch_session_id_derivation",
      "session_owned_process_cleanup_policy"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test src/index.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "description": "Launch process ownership contracts and helpers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-kokoev/narada.git",
    "directory": "packages/launch-process-ownership"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
