{
  "name": "@narada2/carrier-terminal-projection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "nars_runtime_neutral_terminal_projection",
    "owns": [
      "terminal_event_projection",
      "operator_input_protocol_frame_projection"
    ],
    "does_not_own": [
      "provider_runtime",
      "mcp_fabric_hosting",
      "session_runtime_dispatch"
    ]
  },
  "exports": {
    ".": { "types": "./dist/projected-terminal.d.ts", "import": "./dist/projected-terminal.js" },
    "./projected-input": { "types": "./dist/projected-input.d.ts", "import": "./dist/projected-input.js" },
    "./projected-terminal": { "types": "./dist/projected-terminal.d.ts", "import": "./dist/projected-terminal.js" },
    "./terminal-event-rendering": { "types": "./dist/terminal-event-rendering.d.ts", "import": "./dist/terminal-event-rendering.js" },
    "./terminal-markdown": { "types": "./dist/terminal-markdown.d.ts", "import": "./dist/terminal-markdown.js" },
    "./terminal-style": { "types": "./dist/terminal-style.d.ts", "import": "./dist/terminal-style.js" },
    "./terminal-text": { "types": "./dist/terminal-text.d.ts", "import": "./dist/terminal-text.js" },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@narada2/agent-identity": "workspace:*",
    "@narada2/carrier-command-contract": "workspace:*",
    "@narada2/nars-client-projection-contract": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "description": "Runtime-neutral terminal projection without session execution",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-kokoev/narada.git",
    "directory": "packages/carrier-terminal-projection"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
