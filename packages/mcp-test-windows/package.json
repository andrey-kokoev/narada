{
  "name": "@narada-core/mcp-test-windows",
  "version": "0.1.0",
  "description": "Descriptor contracts for approved Windows test gateway MCP surfaces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bunx --bun tsc",
    "build:node": "pnpm exec tsc",
    "typecheck": "bunx --bun tsc --noEmit",
    "typecheck:node": "pnpm exec tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:node": "pnpm exec vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/mcp-test-windows"
  }
}
