{
  "name": "@narada-core/local-history",
  "version": "0.1.0",
  "description": "Site-owned, VS Code-independent local work history",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "config.schema.json",
    "defaults.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon-entry.d.ts",
      "import": "./dist/daemon-entry.js",
      "default": "./dist/daemon-entry.js"
    }
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.json",
    "build:node": "pnpm exec tsc -p tsconfig.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "bunx --bun vitest run",
    "test:node": "pnpm exec vitest run"
  },
  "dependencies": {
    "@narada-core/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/local-history"
  }
}
