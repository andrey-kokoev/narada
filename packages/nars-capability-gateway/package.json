{
  "name": "@narada2/nars-capability-gateway",
  "version": "0.1.0",
  "description": "NARS capability gateway",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "nars_capability_gateway",
    "owns": [
      "mcp_server_lifecycle",
      "gateway_lifecycle_state",
      "tool_catalog_projection",
      "tool_dispatch",
      "tool_execution_lifecycle_state",
      "tool_admission_evidence"
    ],
    "does_not_own": [
      "session_journal",
      "provider_turn_execution",
      "operator_transport"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp-runtime": {
      "types": "./dist/mcp-runtime.d.ts",
      "import": "./dist/mcp-runtime.js"
    },
    "./capability-gateway": {
      "types": "./dist/capability-gateway.d.ts",
      "import": "./dist/capability-gateway.js"
    },
    "./capability-state": {
      "types": "./dist/capability-state.d.ts",
      "import": "./dist/capability-state.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "pretest": "pnpm run build",
    "test": "node --import tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@narada2/launch-process-ownership": "workspace:*",
    "@narada2/mcp-fabric": "workspace:*",
    "@narada2/process-launch-posture": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-kokoev/narada.git",
    "directory": "packages/nars-capability-gateway"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/"
  ]
}
