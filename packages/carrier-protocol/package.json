{
  "name": "@narada-core/carrier-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/carrier-protocol.d.ts",
      "import": "./dist/carrier-protocol.js",
      "default": "./dist/carrier-protocol.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "test": "bun test src/carrier-protocol.test.ts",
    "test:node": "node --import tsx --test src/carrier-protocol.test.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "description": "Shared protocol types, constructors, fixtures, and validators for Narada interactive carriers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/carrier-protocol"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
