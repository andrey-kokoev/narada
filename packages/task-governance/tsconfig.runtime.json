{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@narada2/task-governance/*": ["src/*"]
    },
    "rootDir": "./runtime",
    "outDir": "./dist/runtime",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "runtime/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
