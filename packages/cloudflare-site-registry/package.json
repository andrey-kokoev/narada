{
  "name": "@narada-core/cloudflare-site-registry",
  "version": "0.1.0",
  "description": "Carrier-embedded Cloudflare D1 site registry runtime for site identity, membership, settings, and carrier-session binding",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/cloudflare-site-registry.d.ts",
      "import": "./dist/cloudflare-site-registry.js"
    },
    "./local-projection": {
      "types": "./dist/cloudflare-site-registry-local-projection.d.ts",
      "import": "./dist/cloudflare-site-registry-local-projection.js"
    }
  },
  "scripts": {
    "test": "bun test test/cloudflare-site-registry.test.ts",
    "test:node": "node --import tsx --test test/cloudflare-site-registry.test.ts",
    "pretest": "pnpm run build",
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "deploy:check": "pnpm test",
    "d1:migrations:local": "wrangler d1 migrations apply narada-cloudflare-site-registry --local --config wrangler.toml",
    "d1:migrations:remote": "wrangler d1 migrations apply narada-cloudflare-site-registry --remote --config wrangler.toml",
    "ship": "pnpm test && pnpm deploy:check"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/cloudflare-site-registry"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "main": "./dist/cloudflare-site-registry.js",
  "types": "./dist/cloudflare-site-registry.d.ts",
  "files": [
    "dist/",
    "migrations/",
    "wrangler.toml"
  ]
}
