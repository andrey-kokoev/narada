{
  "name": "@narada-core/site-operational-dashboard",
  "version": "0.1.0",
  "description": "Domain-agnostic static HTML renderer for bounded Site operational dashboard snapshots",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./narada-proper": {
      "types": "./dist/narada-proper.d.ts",
      "import": "./dist/narada-proper.js"
    }
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.json",
    "build:node": "pnpm exec tsc -p tsconfig.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "bunx --bun vitest run",
    "test:node": "pnpm exec vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/site-operational-dashboard"
  }
}
