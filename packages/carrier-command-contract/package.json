{
  "name": "@narada-core/carrier-command-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/carrier-command-contract.d.ts",
      "import": "./dist/carrier-command-contract.js"
    },
    "./commands": "./contracts/commands.json"
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "test": "bun test src/carrier-command-contract.test.ts",
    "test:node": "node --import tsx --test src/carrier-command-contract.test.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "description": "Shared carrier command vocabulary and semantic effect contract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/carrier-command-contract"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
