{
  "name": "@narada2/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Narada renderer-neutral design tokens and compiled UI foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-kokoev/narada.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/andrey-kokoev/narada",
  "bugs": {
    "url": "https://github.com/andrey-kokoev/narada/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "node --import tsx ../../scripts/assert-publication-admission.ts",
    "prepack": "pnpm run build",
    "build": "vite build",
    "test": "pnpm run build && pnpm run typecheck && node --import tsx --test test/ui-foundation.test.ts test/consumer-contract.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18",
    "vite": "^8.1.5",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}