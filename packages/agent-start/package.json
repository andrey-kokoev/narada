{
  "name": "@narada2/agent-start",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@narada2/agent-context-mcp": "workspace:*",
    "@narada2/agent-identity": "workspace:*",
    "@narada2/agent-runtime-server": "workspace:*",
    "@narada2/invokable-intelligence-contract": "workspace:*",
    "@narada2/invokable-intelligence-management": "workspace:*",
    "@narada2/nars-intelligence-kernel-contract": "workspace:*",
    "@narada2/operator-surface-runtime-contract": "workspace:*",
    "@narada2/carrier-protocol": "workspace:*",
    "@narada2/carrier-provider-support": "workspace:*",
    "@narada2/process-launch-posture": "workspace:*",
    "@narada2/nars-client-projection-contract": "workspace:*",
    "@narada2/nars-session-authority": "workspace:*",
    "@narada2/nars-session-core": "workspace:*",
    "@narada2/site-paths": "workspace:*",
    "zod": "^3.22.0"
  },
  "bin": {
    "narada-agent-start": "./dist/src/narada-agent-start.js",
    "narada-agent-start-verify-launchers": "./dist/bin/verify-registered-site-launchers.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/narada-agent-start.d.ts",
      "import": "./dist/src/narada-agent-start.js"
    },
    "./narada-agent-start": {
      "types": "./dist/src/narada-agent-start.d.ts",
      "import": "./dist/src/narada-agent-start.js"
    },
    "./intelligence-launch-context": {
      "types": "./dist/src/intelligence-launch-context.d.ts",
      "import": "./dist/src/intelligence-launch-context.js"
    },
    "./launch-result-v0-contract": {
      "types": "./dist/src/launch-result-v0-contract.d.ts",
      "import": "./dist/src/launch-result-v0-contract.js"
    },
    "./verify-registered-site-launchers": {
      "types": "./dist/bin/verify-registered-site-launchers.d.ts",
      "import": "./dist/bin/verify-registered-site-launchers.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "syntaxcheck": "node --import tsx --check src/narada-agent-start.ts && node --import tsx --check bin/verify-registered-site-launchers.ts",
    "generate:result-schema": "node --import tsx scripts/generate-result-schema.ts",
    "check:result-contract": "node --import tsx scripts/generate-result-schema.ts --check",
    "test": "node --import tsx test/run-agent-start-tests.ts",
    "test:launcher-contract": "node --import tsx test/run-launcher-registry-contract-shards.ts",
    "verify": "node --import tsx bin/verify-registered-site-launchers.ts",
    "test:option-contract": "node --import tsx test/run-option-contract-shards.ts"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "description": "Operator surface runtime for starting Narada agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-kokoev/narada.git",
    "directory": "packages/agent-start"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
