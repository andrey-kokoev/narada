{
  "name": "@narada-core/narada-policy-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "versioned_cross_domain_policy_contract",
    "owns": [
      "admission_policy",
      "object_lifecycle_policy"
    ],
    "does_not_own": [
      "site_specific_dispatch",
      "task_lifecycle_storage",
      "session_execution",
      "transport_or_projection",
      "client_rendering"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./admission-lifecycle-policy": {
      "types": "./dist/admission-lifecycle-policy.d.ts",
      "import": "./dist/admission-lifecycle-policy.js",
      "default": "./dist/admission-lifecycle-policy.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "test": "bun test src",
    "test:node": "node --import tsx --test src/*.test.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "description": "Narada admission and object lifecycle policy contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/narada-policy-contract"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
