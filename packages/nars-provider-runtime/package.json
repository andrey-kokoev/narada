{
  "name": "@narada-core/nars-provider-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "nars_provider_runtime",
    "owns": [
      "canonical_request_shaping",
      "canonical_provider_transport",
      "provider_process_lifecycle",
      "owned_process_state",
      "provider_invocation_lifecycle"
    ],
    "does_not_own": [
      "intelligence_selection",
      "catalog_policy",
      "session_persistence",
      "mcp_hosting",
      "control_protocol"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canonical-invocation-adapter": {
      "types": "./dist/canonical-invocation-adapter.d.ts",
      "import": "./dist/canonical-invocation-adapter.js"
    },
    "./canonical-protocol-adapters": {
      "types": "./dist/canonical-protocol-adapters.d.ts",
      "import": "./dist/canonical-protocol-adapters.js"
    },
    "./canonical-transports": {
      "types": "./dist/canonical-transports.d.ts",
      "import": "./dist/canonical-transports.js"
    },
    "./credential-locator": {
      "types": "./dist/credential-locator.d.ts",
      "import": "./dist/credential-locator.js"
    },
    "./openai-compatible-chat": {
      "types": "./dist/openai-compatible-chat.d.ts",
      "import": "./dist/openai-compatible-chat.js"
    },
    "./owned-process-state": {
      "types": "./dist/owned-process-state.d.ts",
      "import": "./dist/owned-process-state.js"
    },
    "./process-supervisor": {
      "types": "./dist/process-supervisor.d.ts",
      "import": "./dist/process-supervisor.js"
    },
    "./provider-invocation-state": {
      "types": "./dist/provider-invocation-state.d.ts",
      "import": "./dist/provider-invocation-state.js"
    },
    "./runtime-tail-utils": {
      "types": "./dist/runtime-tail-utils.d.ts",
      "import": "./dist/runtime-tail-utils.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && bun test src",
    "test:node": "pnpm run build:node && node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@narada-core/carrier-provider-support": "workspace:*",
    "@narada-core/mcp-fabric": "workspace:*",
    "@narada-core/process-launch-posture": "workspace:*"
  },
  "description": "NARS provider runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/nars-provider-runtime"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "files": [
    "dist/"
  ]
}
