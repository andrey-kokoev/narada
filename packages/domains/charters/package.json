{
  "name": "@narada-core/charters",
  "version": "0.1.0",
  "description": "Charter contracts, knowledge sources, and coordinator bindings for mailbox agents",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/domains/charters"
  },
  "keywords": [
    "exchange",
    "charter",
    "mailbox-agent",
    "knowledge-source"
  ],
  "author": "Narada <team@narada.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node --import tsx ../../../scripts/assert-publication-admission.ts",
    "build": "bunx --bun tsc -p tsconfig.json",
    "build:node": "pnpm exec tsc -p tsconfig.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "bunx --bun vitest run",
    "test:node": "pnpm exec vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@narada-core/process-launch-posture": "workspace:*",
    "zod": "^3.25.76"
  },
  "homepage": "https://github.com/narada-core/narada",
  "bugs": {
    "url": "https://github.com/narada-core/narada/issues"
  }
}
