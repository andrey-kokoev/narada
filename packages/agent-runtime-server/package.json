{
  "name": "@narada2/agent-runtime-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "narada": {
    "package_role": "nars_runtime_server",
    "owns": [
      "server_request_handling",
      "server_request_lifecycle",
      "session_binding",
      "session_status_and_health_projection",
      "health_projection_request_lifecycle",
      "runtime_event_subscription",
      "runtime_lifecycle_hooks",
      "runtime_intelligence_reconfiguration",
      "artifact_http_request_handling",
      "attachment_contract",
      "carrier_substrate_handoff",
      "runtime_host_lifecycle",
      "capability_gateway_binding"
    ],
    "carrier_substrate": "@narada2/carrier-runtime in-process",
    "runtime_dependency_owner": "nars-session-core owns session control and durability; this package owns the scoped capability-gateway binding; nars-provider-runtime supplies provider execution"
  },
  "bin": {
    "narada-agent-runtime-server": "./bin/narada-agent-runtime-server.ts"
  },
  "exports": {
    ".": "./src/server-wrapper.ts",
    "./runtime-session-binding": "./src/runtime-session-binding.ts",
    "./session-core-runtime-service": "./src/session-core-runtime-service.ts",
    "./runtime-context": "./src/runtime-context.ts",
    "./control-input-bridge": "./src/control-input-bridge.ts",
    "./runtime-host-state": "./src/runtime-host-state.ts",
    "./runtime-request-state": "./src/runtime-request-state.ts",
    "./health-projection-request-state": "./src/health-projection-request-state.ts",
    "./runtime-control-contract": "./src/runtime-control-contract.ts",
    "./intelligence-runtime-reconfiguration-state": "./src/intelligence-runtime-reconfiguration-state.ts",
    "./intelligence-runtime-controller": "./src/intelligence-runtime-controller.ts",
    "./local-intelligence-runtime": {
      "types": "./src/local-intelligence-runtime.d.ts",
      "import": "./src/local-intelligence-runtime.ts"
    },
    "./local-topology-observer": "./src/local-topology-observer.ts",
    "./runtime-server-events": "./src/runtime-server-events.ts",
    "./task-executability-dispatch": "./src/task-executability-dispatch.ts",
    "./test-fixtures": "./src/test-fixtures.ts",
    "./agent-cli-windows-wrapper-template": "./templates/Start-AgentCliSession.ps1",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts src/*.test.ts",
    "test:e2e:pty": "node --import tsx test/pty-e2e.ts",
    "test:live:pi-client-kernel": "node --import tsx test/live-pi-client-kernel-substitutability-fixture-e2e.ts --enable-live-e2e",
    "test:live:codex-provider-admission": "pnpm --filter @narada2/cli build && node --import tsx test/live-codex-provider-admission-e2e.ts --enable-live-codex",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@narada2/agent-identity": "workspace:*",
    "@narada2/carrier-command-contract": "workspace:*",
    "@narada2/carrier-runtime": "workspace:*",
    "@narada2/carrier-protocol": "workspace:*",
    "@narada2/carrier-terminal-projection": "workspace:*",
    "@narada2/carrier-provider-support": "workspace:*",
    "@narada2/invokable-intelligence-materialization": "workspace:*",
    "@narada2/invokable-intelligence-contract": "workspace:*",
    "@narada2/invokable-intelligence-registry": "workspace:*",
    "@narada2/invokable-intelligence-resolver": "workspace:*",
    "@narada2/invokable-intelligence-runtime": "workspace:*",
    "@narada2/launch-process-ownership": "workspace:*",
    "@narada2/nars-session-authority": "workspace:*",
    "@narada2/nars-session-core": "workspace:*",
    "@narada2/nars-runtime-contract": "workspace:*",
    "@narada2/nars-capability-gateway": "workspace:*",
    "@narada2/nars-intelligence-kernel-contract": "workspace:*",
    "@narada2/nars-pi-kernel": "workspace:*",
    "@narada2/nars-provider-runtime": "workspace:*",
    "@narada2/process-launch-posture": "workspace:*",
    "@narada2/site-paths": "workspace:*"
  },
  "devDependencies": {
    "node-pty": "^1.1.0"
  },
  "description": "NARS runtime server for session and carrier handoff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-kokoev/narada.git",
    "directory": "packages/agent-runtime-server"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
