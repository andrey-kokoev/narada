{
  "name": "@narada-core/nars-session-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "nars_session_core",
    "native_implementation": "native/",
    "native_implementation_status": "parity_slice_in_progress",
    "owns": [
      "session_lifecycle_state",
      "session_shutdown_state",
      "durable_event_journal",
      "event_sequence_and_replay",
      "artifact_registry",
      "artifact_lifecycle_state",
      "operator_input_queue_state",
      "input_admission_state",
      "session_health_and_recovery_snapshots",
      "turn_lifecycle_state",
      "session_registry_projection",
      "authority_transition_state",
      "authority_handoff_lifecycle_state",
      "recovery_attempt_state",
      "event_attachment_state"
    ],
    "does_not_own": [
      "provider_turn_execution",
      "mcp_transport_or_dispatch",
      "effect_admission",
      "external_effect_confirmation",
      "client_rendering"
    ]
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./event-log": { "types": "./dist/event-log.d.ts", "import": "./dist/event-log.js", "default": "./dist/event-log.js" },
    "./event-hub": { "types": "./dist/event-hub.d.ts", "import": "./dist/event-hub.js", "default": "./dist/event-hub.js" },
    "./event-attachment-state": { "types": "./dist/event-attachment-state.d.ts", "import": "./dist/event-attachment-state.js", "default": "./dist/event-attachment-state.js" },
    "./surface-attachment": { "types": "./dist/surface-attachment.d.ts", "import": "./dist/surface-attachment.js", "default": "./dist/surface-attachment.js" },
    "./surface-attachment-registry": { "types": "./dist/surface-attachment-registry.d.ts", "import": "./dist/surface-attachment-registry.js", "default": "./dist/surface-attachment-registry.js" },
    "./session-lifecycle-state": { "types": "./dist/session-lifecycle-state.d.ts", "import": "./dist/session-lifecycle-state.js", "default": "./dist/session-lifecycle-state.js" },
    "./session-shutdown-state": { "types": "./dist/session-shutdown-state.d.ts", "import": "./dist/session-shutdown-state.js", "default": "./dist/session-shutdown-state.js" },
    "./artifact-lifecycle-state": { "types": "./dist/artifact-lifecycle-state.d.ts", "import": "./dist/artifact-lifecycle-state.js", "default": "./dist/artifact-lifecycle-state.js" },
    "./artifacts": { "types": "./dist/artifacts.d.ts", "import": "./dist/artifacts.js", "default": "./dist/artifacts.js" },
    "./input-queue": { "types": "./dist/input-queue.d.ts", "import": "./dist/input-queue.js", "default": "./dist/input-queue.js" },
    "./input-admission-state": { "types": "./dist/input-admission-state.d.ts", "import": "./dist/input-admission-state.js", "default": "./dist/input-admission-state.js" },
    "./operator-input-queue-state": { "types": "./dist/operator-input-queue-state.d.ts", "import": "./dist/operator-input-queue-state.js", "default": "./dist/operator-input-queue-state.js" },
    "./session-status-snapshots": { "types": "./dist/session-status-snapshots.d.ts", "import": "./dist/session-status-snapshots.js", "default": "./dist/session-status-snapshots.js" },
    "./session-index": { "types": "./dist/session-index.d.ts", "import": "./dist/session-index.js", "default": "./dist/session-index.js" },
    "./authority-transition-state": { "types": "./dist/authority-transition-state.d.ts", "import": "./dist/authority-transition-state.js", "default": "./dist/authority-transition-state.js" },
    "./authority-transition-fsm": { "types": "./dist/authority-transition-fsm.d.ts", "import": "./dist/authority-transition-fsm.js", "default": "./dist/authority-transition-fsm.js" },
    "./authority-handoff-fsm": { "types": "./dist/authority-handoff-fsm.d.ts", "import": "./dist/authority-handoff-fsm.js", "default": "./dist/authority-handoff-fsm.js" },
    "./recovery-attempt-state": { "types": "./dist/recovery-attempt-state.d.ts", "import": "./dist/recovery-attempt-state.js", "default": "./dist/recovery-attempt-state.js" },
    "./session-core": { "types": "./dist/session-core.d.ts", "import": "./dist/session-core.js", "default": "./dist/session-core.js" },
    "./session-supervisor": { "types": "./dist/session-supervisor.d.ts", "import": "./dist/session-supervisor.js", "default": "./dist/session-supervisor.js" },
    "./turn-state": { "types": "./dist/turn-state.d.ts", "import": "./dist/turn-state.js", "default": "./dist/turn-state.js" },
    "./session-control-contract": { "types": "./dist/session-control-contract.d.ts", "import": "./dist/session-control-contract.js", "default": "./dist/session-control-contract.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@narada-core/agent-identity": "workspace:*",
    "@narada-core/carrier-protocol": "workspace:*",
    "@narada-core/nars-runtime-contract": "workspace:*",
    "@narada-core/site-paths": "workspace:*"
  },
  "description": "NARS session core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/nars-session-core"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
