{
  "name": "@narada-core/operator-console-mirror-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "operator_console_remote_mirror_lifecycle",
    "authority_owner": "@narada-core/operator-console-mirror-runtime",
    "surface": "operator_console",
    "presentation_only": false
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "bun test test",
    "test:node": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@narada-core/nars-provider-runtime": "workspace:*",
    "@narada-core/operator-console-remote-gateway": "workspace:*",
    "@narada-core/operator-console-contract": "workspace:*",
    "@narada-core/process-launch-posture": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "description": "Governed lifecycle for the local Operator Console Cloudflare mirror",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/operator-console-mirror-runtime"
  },
  "engines": {"node": ">=22.0.0", "bun": ">=1.3.0"}
}
