{
  "name": "@narada-core/narada-proper-mcp",
  "version": "0.1.0",
  "description": "Target-local Narada proper agent-facing MCP surface",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "narada-proper-mcp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.json",
    "build:node": "pnpm exec tsc -p tsconfig.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "bunx --bun vitest run",
    "test:node": "pnpm exec vitest run"
  },
  "dependencies": {
    "@narada-core/agent-context-memory": "workspace:*",
    "@narada-core/process-launch-posture": "workspace:*",
    "@narada-core/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/narada-proper-mcp"
  }
}
