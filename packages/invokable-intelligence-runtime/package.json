{
  "name": "@narada-core/invokable-intelligence-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "narada": {
    "package_role": "portable_invocation_gateway_and_evidence_recorder",
    "surface": "invokable_intelligence",
    "presentation_only": false,
    "authority_owner": "@narada-core/cli"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "bun test test",
    "test:node": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@narada-core/invokable-intelligence-contract": "workspace:*",
    "@narada-core/invokable-intelligence-materialization": "workspace:*",
    "@narada-core/invokable-intelligence-registry": "workspace:*",
    "@narada-core/invokable-intelligence-resolver": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "description": "Local Narada runtime integration for invokable intelligence",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/invokable-intelligence-runtime"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
