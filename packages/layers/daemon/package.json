{
  "name": "@narada-core/daemon",
  "version": "0.1.0",
  "description": "Long-running daemon for the Narada deterministic state compiler and control plane",
  "main": "./dist/service.js",
  "types": "./dist/service.d.ts",
  "type": "module",
  "bin": {
    "narada-daemon": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/layers/daemon"
  },
  "keywords": [
    "narada",
    "state-compiler",
    "sync",
    "exchange",
    "microsoft-graph",
    "email",
    "automation",
    "daemon"
  ],
  "author": "Narada <team@narada.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node --import tsx ../../../scripts/assert-publication-admission.ts",
    "build": "bunx --bun tsc",
    "build:node": "pnpm exec tsc",
    "typecheck": "bunx --bun tsc --noEmit",
    "typecheck:node": "pnpm exec tsc --noEmit",
    "start": "bun dist/index.js",
    "start:node": "node dist/index.js",
    "test": "bunx --bun vitest run",
    "test:node": "pnpm exec vitest run",
    "test:unit": "bunx --bun vitest run test/unit",
    "test:unit:node": "pnpm exec vitest run test/unit",
    "test:integration": "bunx --bun vitest run test/integration",
    "test:integration:node": "pnpm exec vitest run test/integration"
  },
  "dependencies": {
    "@narada-core/control-plane": "workspace:*",
    "@narada-core/charters": "workspace:*",
    "@narada-core/search": "workspace:*"
  },
  "devDependencies": {
    "@narada-core/sqlite": "workspace:*",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/narada-core/narada",
  "bugs": {
    "url": "https://github.com/narada-core/narada/issues"
  }
}
