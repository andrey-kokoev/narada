{
  "name": "@narada-core/site-operating-loop",
  "version": "0.1.0",
  "description": "Narada Site Operating Loop substrate",
  "private": true,
  "type": "module",
  "main": "./dist/src/site-loop-store.js",
  "types": "./dist/src/site-loop-store.d.ts",
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "bin": {
    "narada-site-loop": "./dist/bin/narada-site-loop.js"
  },
  "dependencies": {
    "@narada-core/process-launch-posture": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/src/site-loop-store.d.ts",
      "import": "./dist/src/site-loop-store.js"
    },
    "./site-loop-store": {
      "types": "./dist/src/site-loop-store.d.ts",
      "import": "./dist/src/site-loop-store.js"
    },
    "./runner": {
      "types": "./dist/src/runner.d.ts",
      "import": "./dist/src/runner.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/src/runtime.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "import": "./dist/src/server.js"
    },
    "./loop-module": {
      "types": "./dist/src/loop-module.d.ts",
      "import": "./dist/src/loop-module.js"
    },
    "./policy": {
      "types": "./dist/src/policy.d.ts",
      "import": "./dist/src/policy.js"
    },
    "./state": {
      "types": "./dist/src/site-operating-loop-state.d.ts",
      "import": "./dist/src/site-operating-loop-state.js"
    },
    "./execution-state": {
      "types": "./dist/src/site-operating-loop-execution-state.d.ts",
      "import": "./dist/src/site-operating-loop-execution-state.js"
    },
    "./runtime-host-state": {
      "types": "./dist/src/runtime-host-state.d.ts",
      "import": "./dist/src/runtime-host-state.js"
    }
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/site-operating-loop"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}