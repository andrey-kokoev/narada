{
  "name": "@narada-core/task-lifecycle-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "pnpm run build",
    "test": "bun test test",
    "pretest:node": "pnpm run build:node",
    "test:node": "node --import tsx --test test/*.test.ts",
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio-json-rpc": {
      "types": "./dist/stdio-json-rpc.d.ts",
      "import": "./dist/stdio-json-rpc.js"
    },
    "./tool-call-pipeline": {
      "types": "./dist/tool-call-pipeline.d.ts",
      "import": "./dist/tool-call-pipeline.js"
    }
  },
  "files": [
    "dist/"
  ],
  "description": "Task lifecycle kernel runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/task-lifecycle-kernel"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
