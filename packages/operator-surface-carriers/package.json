{
  "name": "@narada-core/operator-surface-carriers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && bun test src/operator-surface-carriers.test.ts",
    "test:node": "pnpm run build:node && node --import tsx --test src/operator-surface-carriers.test.ts"
  },
  "dependencies": {
    "@narada-core/process-launch-posture": "workspace:*"
  },
  "description": "Operator surface carrier templates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/operator-surface-carriers"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "files": [
    "dist/"
  ]
}
