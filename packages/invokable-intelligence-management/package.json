{
  "name": "@narada-core/invokable-intelligence-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "narada-intelligence": "./dist/narada-intelligence.js"
  },
  "narada": {
    "package_role": "intelligence_catalog_policy_management_and_migration",
    "surface": "invokable_intelligence",
    "presentation_only": false,
    "authority_owner": "@narada-core/cli"
  },
  "exports": {
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./local-readiness": {
      "types": "./dist/local-readiness.d.ts",
      "import": "./dist/local-readiness.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@narada-core/invokable-intelligence-contract": "workspace:*",
    "@narada-core/invokable-intelligence-materialization": "workspace:*",
    "@narada-core/invokable-intelligence-registry": "workspace:*",
    "@narada-core/invokable-intelligence-resolver": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "description": "Application-service boundary for managing Narada's invokable-intelligence catalog, policy, and topology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/invokable-intelligence-management"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
