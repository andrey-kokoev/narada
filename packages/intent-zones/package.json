{
  "name": "@narada-core/intent-zones",
  "version": "0.1.0",
  "description": "Narada Command Execution and Testing Intent Zone contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing-intent": {
      "types": "./dist/testing-intent.d.ts",
      "import": "./dist/testing-intent.js"
    },
    "./command-execution-intent": {
      "types": "./dist/command-execution-intent.d.ts",
      "import": "./dist/command-execution-intent.js"
    },
    "./repo-publication-intent": {
      "types": "./dist/repo-publication-intent.d.ts",
      "import": "./dist/repo-publication-intent.js"
    }
  },
  "scripts": {
    "build": "bunx --bun tsc",
    "build:node": "pnpm exec tsc",
    "typecheck": "bunx --bun tsc --noEmit",
    "typecheck:node": "pnpm exec tsc --noEmit",
    "test": "bunx --bun vitest run --passWithNoTests",
    "test:node": "pnpm exec vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/intent-zones"
  }
}
