{
  "name": "@narada-core/mcp-protocol-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/mcp-protocol-contract.d.ts",
      "import": "./dist/mcp-protocol-contract.js"
    },
    "./json-rpc": "./contracts/json-rpc.json"
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "test": "bun test src/mcp-protocol-contract.test.ts",
    "test:node": "node --import tsx --test src/mcp-protocol-contract.test.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "description": "MCP protocol contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/mcp-protocol-contract"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
