{
  "name": "@narada-core/operator-console-remote-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:bun": "bun test test/*.test.ts",
    "test:node": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@narada-core/operator-console-contract": "workspace:*",
    "@narada-core/operator-router": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "description": "Authenticated local crossing boundary for the remote Operator Console projection",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/operator-console-remote-gateway"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
