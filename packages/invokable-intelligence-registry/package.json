{
  "name": "@narada-core/invokable-intelligence-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "narada": {
    "package_role": "portable_intelligence_registry_storage",
    "surface": "invokable_intelligence",
    "presentation_only": false,
    "authority_owner": "@narada-core/cli"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./d1": {
      "types": "./dist/d1-store.d.ts",
      "import": "./dist/d1-store.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json",
    "test": "bun test test/index.test.ts",
    "test:node": "node --import tsx --test test/index.test.ts"
  },
  "dependencies": {
    "@narada-core/invokable-intelligence-contract": "workspace:*",
    "@narada-core/sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "description": "Portable persistence for the invokable-intelligence ontology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/invokable-intelligence-registry"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
