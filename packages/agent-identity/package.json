{
  "name": "@narada-core/agent-identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "agent_identity_projection_contract",
    "owns": [
      "agent_identity_ref_derivation",
      "agent_identity_ref_v2_resolution",
      "canonical_agent_display_identity",
      "operator_renderable_value_contract"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "test": "bun test src/index.test.ts",
    "test:node": "node --import tsx --test src/index.test.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "description": "Agent identity projection contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/agent-identity"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
