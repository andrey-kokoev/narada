{
  "name": "@narada-core/macos-site",
  "version": "0.1.0",
  "description": "macOS Site materialization for Narada bounded Cycle execution",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bunx --bun tsc",
    "build:node": "pnpm exec tsc",
    "typecheck": "bunx --bun tsc --noEmit",
    "typecheck:node": "pnpm exec tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:node": "pnpm exec vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@narada-core/control-plane": "workspace:*",
    "@narada-core/process-launch-posture": "workspace:*",
    "@narada-core/sqlite": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/sites/macos"
  }
}
