{
  "name": "@narada-core/cloudflare-site",
  "version": "0.1.0",
  "description": "Cloudflare Worker entrypoint for Narada Site materialization and bounded Cycle execution",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/sites/cloudflare"
  },
  "keywords": [
    "narada",
    "cloudflare",
    "worker",
    "site",
    "cycle"
  ],
  "author": "Narada <team@narada.dev>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun tsc",
    "build:node": "pnpm exec tsc",
    "typecheck": "bunx --bun tsc --noEmit",
    "typecheck:node": "pnpm exec tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:node": "pnpm exec vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@narada-core/charters": "workspace:*",
    "@narada-core/windows-site": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260421.1",
    "@narada-core/sqlite": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/narada-core/narada",
  "bugs": {
    "url": "https://github.com/narada-core/narada/issues"
  }
}
