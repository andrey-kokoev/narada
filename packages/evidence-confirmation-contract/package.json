{
  "name": "@narada-core/evidence-confirmation-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "versioned_cross_domain_evidence_contract",
    "owns": [
      "evidence_packet",
      "effect_confirmation",
      "evidence_correlation_audit"
    ],
    "does_not_own": [
      "permission_or_admission",
      "task_lifecycle_storage",
      "runtime_execution",
      "provider_transport",
      "client_rendering"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./evidence-confirmation": {
      "types": "./dist/evidence-confirmation.d.ts",
      "import": "./dist/evidence-confirmation.js",
      "default": "./dist/evidence-confirmation.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "test": "bun test src",
    "test:node": "node --import tsx --test src/*.test.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "description": "Narada evidence packets, correlation, and effect confirmation contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/evidence-confirmation-contract"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
