{
  "name": "@narada-core/nars-session-authority",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Authority-owned singleton admission for Narada Agent Runtime Server sessions",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-sqlite": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@narada-core/sqlite": "workspace:*"
  },
  "scripts": {
    "test": "bun test src",
    "test:node": "node --import tsx --test src/*.test.ts",
    "pretest": "pnpm run build",
    "pretest:node": "pnpm run build:node",
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  },
  "files": [
    "dist/"
  ]
}
