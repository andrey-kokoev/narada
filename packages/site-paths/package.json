{
  "name": "@narada-core/site-paths",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "test": "bun test src",
    "test:node": "node --import tsx --test src/*.test.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "description": "Site path semantics contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/site-paths"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
