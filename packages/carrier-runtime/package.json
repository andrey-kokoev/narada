{
  "name": "@narada2/carrier-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "nars_carrier_turn_adapter",
    "owns": [
      "stateless_intelligence_invocation_turn_adapter"
    ],
    "does_not_own": [
      "session_persistence",
      "mcp_hosting",
      "transport_supervision"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./carrier-turn-adapter": {
      "types": "./dist/carrier-turn-adapter.d.ts",
      "import": "./dist/carrier-turn-adapter.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "description": "NARS carrier runtime substrate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrey-kokoev/narada.git",
    "directory": "packages/carrier-runtime"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
