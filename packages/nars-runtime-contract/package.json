{
  "name": "@narada-core/nars-runtime-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "nars_runtime_contract",
    "owns": [
      "runtime_control_method_registry",
      "runtime_intelligence_reconfiguration_request_schema",
      "runtime_surface_origin_authority_capability_contract"
    ],
    "does_not_own": [
      "runtime_execution",
      "provider_binding_resolution",
      "client_rendering"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/nars-runtime-contract.d.ts",
      "import": "./dist/nars-runtime-contract.js"
    },
    "./runtime-surface-contract": {
      "types": "./dist/runtime-surface-contract.d.ts",
      "import": "./dist/runtime-surface-contract.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/nars-runtime-contract.d.ts",
  "scripts": {
    "build": "bunx --bun tsc -p tsconfig.build.json",
    "build:node": "pnpm exec tsc -p tsconfig.build.json",
    "test": "bun test src",
    "test:node": "node --import tsx --test src/*.test.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "typecheck:node": "pnpm exec tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@narada-core/carrier-protocol": "workspace:*"
  },
  "description": "NARS runtime contracts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/nars-runtime-contract"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
