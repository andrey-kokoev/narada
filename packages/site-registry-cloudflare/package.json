{
  "name": "@narada-core/site-registry-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare Worker realization of a Narada Site Telemetry Surface serving SiteRegistry read models",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./deploy-readiness": {
      "types": "./dist/deploy-readiness.d.ts",
      "import": "./dist/deploy-readiness.js"
    },
    "./site-scope-chat": {
      "types": "./dist/site-scope-chat.d.ts",
      "import": "./dist/site-scope-chat.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:fixture": "vitest run test/smoke-fixture.test.ts",
    "deploy:preflight": "pnpm build && node dist/hosted-telemetry-surface.js preflight --config wrangler.jsonc",
    "deploy:verify": "pnpm build && node dist/hosted-telemetry-surface.js verify",
    "deploy:live": "pnpm build && node dist/hosted-telemetry-surface.js deploy --live --config wrangler.jsonc"
  },
  "dependencies": {
    "@narada-core/process-launch-posture": "workspace:*",
    "@narada-core/site-config": "workspace:*",
    "@narada-core/site-inbox": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260421.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10",
    "@types/node": "^22.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/site-registry-cloudflare"
  }
}
