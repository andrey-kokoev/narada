{
  "name": "@narada-core/carrier-provider-support",
  "version": "0.1.0",
  "description": "Provider command resolution support for carrier surfaces",
  "private": true,
  "type": "module",
  "narada": {
    "package_role": "carrier_provider_support",
    "owns": [
      "ai_process_invocation_state"
    ],
    "does_not_own": [
      "session_persistence",
      "provider_turn_lifecycle",
      "mcp_hosting"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai-process-invocation": {
      "types": "./dist/ai-process-invocation.d.ts",
      "import": "./dist/ai-process-invocation.js"
    },
    "./ai-process-invocation-state": {
      "types": "./dist/ai-process-invocation-state.d.ts",
      "import": "./dist/ai-process-invocation-state.js"
    },
    "./codex-subscription-auth": {
      "types": "./dist/codex-subscription-auth.d.ts",
      "import": "./dist/codex-subscription-auth.js"
    },
    "./codex-subscription-command": {
      "types": "./dist/codex-subscription-command.d.ts",
      "import": "./dist/codex-subscription-command.js"
    },
    "./codex-subscription-models": {
      "types": "./dist/codex-subscription-models.d.ts",
      "import": "./dist/codex-subscription-models.js"
    },
    "./codex-subscription-readiness": {
      "types": "./dist/codex-subscription-readiness.d.ts",
      "import": "./dist/codex-subscription-readiness.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test src",
    "test:node": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@narada-core/process-launch-posture": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narada-core/narada.git",
    "directory": "packages/carrier-provider-support"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
