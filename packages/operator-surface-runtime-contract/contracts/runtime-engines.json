{
  "schema": "narada.runtime_engine.v1",
  "admitted_runtime_engines": [
    "node",
    "bun",
    "rust"
  ],
  "default_runtime_engine": "node",
  "engine_profiles": {
    "node": {
      "execution_kind": "direct",
      "entrypoint_kind": "javascript_module"
    },
    "bun": {
      "execution_kind": "direct",
      "entrypoint_kind": "javascript_module"
    },
    "rust": {
      "execution_kind": "native_runtime_host",
      "entrypoint_kind": "native_binary",
      "ownership": ["nars_session_core", "nars_session_authority"],
      "delegation_posture": "provider_and_mcp_adapters_are_explicit"
    }
  }
}
